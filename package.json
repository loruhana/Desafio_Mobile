{
  "name": "desafio-mobile",
  "version": "1.0.0",
  "description": "Automação de testes mobile do native-demo-app (WebdriverIO + Appium + Mocha + Chai + Allure)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "appium:drivers": "appium driver list --installed",
    "test": "npm run test:android",
    "test:android": "wdio run ./config/wdio.android.conf.js",
    "test:ios": "wdio run ./config/wdio.ios.conf.js",
    "test:browserstack": "wdio run ./config/wdio.browserstack.conf.js",
    "report:generate": "allure generate reports/allure-results --clean -o reports/allure-report",
    "report:open": "allure open reports/allure-report",
    "report": "npm run report:generate && npm run report:open",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@wdio/allure-reporter": "^9.32.0",
    "@wdio/appium-service": "^9.32.0",
    "@wdio/browserstack-service": "^9.39.3",
    "@wdio/cli": "^9.32.0",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "allure-commandline": "^2.46.1",
    "appium": "^3.8.0",
    "appium-uiautomator2-driver": "^8.7.0",
    "appium-xcuitest-driver": "^12.15.0",
    "chai": "^5.3.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0"
  }
}

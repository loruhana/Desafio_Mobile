# Copie para ".env" e preencha somente o que for usar. O ".env" não é versionado.

# --- Android local (opcional) ---
# UDID do dispositivo/emulador quando houver mais de um conectado (veja "adb devices").
ANDROID_UDID=
# Caminho alternativo para o .apk (padrão: apps/android.wdio.native.app.apk).
ANDROID_APP_PATH=
ANDROID_DEVICE_NAME=

# --- iOS Simulator (opcional, somente macOS) ---
IOS_APP_PATH=
IOS_DEVICE_NAME=iPhone 16
IOS_PLATFORM_VERSION=18.5

# --- BrowserStack (opcional) ---
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
# Valor "bs://..." retornado pelo upload do app (veja o README).
BROWSERSTACK_APP_ID=
BROWSERSTACK_DEVICE=Samsung Galaxy S23
BROWSERSTACK_OS_VERSION=13.0
